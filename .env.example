# Supabase PostgreSQL / Shared Pooler connection string.
# Replace [YOUR-PASSWORD] with the database password from Supabase.
DATABASE_URL=postgresql://postgres.sfkeodbjvkvuphylgatc:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Keep these stable between deployments.
JWT_SECRET=change-me-to-a-long-random-secret
DB_ENCRYPTION_KEY=change-me-to-a-long-random-database-key

# Supabase requires SSL by default. Set to false only for a local Postgres instance.
POSTGRES_SSL=true
